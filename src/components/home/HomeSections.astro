<div class="home__sections">
  <section class="home-section hero" aria-labelledby="hero-title">
    <div class="hero__brand" aria-label="Bontr">BONTR</div>
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">
        <span>BONTR</span>
        <em>SHAPES</em>
        <span>TOMORROW</span>
      </h1>
      <p class="hero__lede">Bridging ideas, people and technology<br />for a more human future.</p>
      <a class="hero__cta" href="#field" data-explore-cta>
        <span>Explore Bontr</span>
        <span class="hero__cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="home-section field" id="field" aria-labelledby="field-title">
    <div class="field__copy">
      <p class="field__eyebrow">02 /</p>
      <h2 id="field-title" class="field__title">
        <span>A WIDER</span>
        <span>FIELD OF</span>
        <em>POSSIBILITY</em>
      </h2>
      <p class="field__lede">Bontr brings together ideas, people and technology to explore what's next — expanding human potential beyond the visible.</p>
    </div>
  </section>
</div>

<script>
  const exploreCta = document.querySelector<HTMLAnchorElement>('[data-explore-cta]');
  const fieldSection = document.querySelector<HTMLElement>('#field');

  if (exploreCta && fieldSection) {
    let animationFrame = 0;
    let isAnimating = false;
    let previousScrollBehavior = '';

    const stopScrollAnimation = () => {
      if (!isAnimating) return;
      cancelAnimationFrame(animationFrame);
      isAnimating = false;
      document.documentElement.style.scrollBehavior = previousScrollBehavior;
    };

    const easeInOutCubic = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

    exploreCta.addEventListener('click', (event) => {
      event.preventDefault();

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        fieldSection.scrollIntoView({ behavior: 'auto', block: 'start' });
        history.pushState(null, '', '#field');
        return;
      }

      stopScrollAnimation();
      const startY = window.scrollY;
      const targetY = fieldSection.getBoundingClientRect().top + window.scrollY;
      const distance = targetY - startY;
      const screens = Math.abs(distance) / Math.max(1, window.innerHeight);
      const duration = Math.min(3400, Math.max(2600, screens * 1400));
      const startedAt = performance.now();

      previousScrollBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
      isAnimating = true;

      const tick = (now: number) => {
        const progress = Math.min(1, (now - startedAt) / duration);
        window.scrollTo(0, startY + distance * easeInOutCubic(progress));

        if (progress < 1 && isAnimating) {
          animationFrame = requestAnimationFrame(tick);
          return;
        }

        isAnimating = false;
        document.documentElement.style.scrollBehavior = previousScrollBehavior;
        history.pushState(null, '', '#field');
      };

      animationFrame = requestAnimationFrame(tick);
    });

    window.addEventListener('wheel', stopScrollAnimation, { passive: true });
    window.addEventListener('touchstart', stopScrollAnimation, { passive: true });
  }
</script>
